{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Uzo Labs",
  "description": "The developer path for BOT Chain. SDKs, templates and infrastructure that take you from zero to shipped.",
  "colors": {
    "primary": "#D9A441",
    "light": "#E8BF6A",
    "dark": "#B8862E"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://uzolabs.xyz"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "dark"
  },
  "background": {
    "color": {
      "light": "#F5F1EA",
      "dark": "#0B0A09"
    }
  },
  "fonts": {
    "heading": {
      "family": "Reggae One"
    },
    "body": {
      "family": "Satoshi",
      "source": "/fonts/Satoshi-Variable.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "banner": {
    "content": "Uzo is in early development and moves fast. Check the [changelog](/changelog) for what's new.",
    "dismissible": true
  },
  "navbar": {
    "links": [
      {
        "label": "Uzo Deploy",
        "icon": "rocket",
        "href": "https://deploy.uzolabs.xyz"
      },
      {
        "label": "GitHub",
        "icon": "github",
        "href": "https://github.com/uzolabs"
      },
      {
        "label": "npm",
        "icon": "package",
        "href": "https://www.npmjs.com/org/uzolabs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start building",
      "href": "https://docs.uzolabs.xyz/get-started/quickstart"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "metadata": {
    "timestamp": true
  },
  "variables": {
    "mainnet-chain-id": "677",
    "testnet-chain-id": "968",
    "mainnet-rpc": "https://rpc.botchain.ai",
    "testnet-rpc": "https://rpc.bohr.life",
    "mainnet-explorer": "https://scan.botchain.ai",
    "testnet-explorer": "https://scan.bohr.life",
    "faucet-url": "https://faucet.botchain.ai/basic",
    "sdk-package": "@uzolabs/sdk",
    "deploy-url": "https://deploy.uzolabs.xyz"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/uzolabs"
        },
        {
          "anchor": "BOTScan",
          "icon": "search",
          "href": "https://scan.botchain.ai"
        },
        {
          "anchor": "Testnet faucet",
          "icon": "droplets",
          "href": "https://faucet.botchain.ai/basic"
        },
        {
          "anchor": "BOT Chain docs",
          "icon": "external-link",
          "href": "https://dev-docs.botchain.ai/docs/intro"
        }
      ]
    },
    "tabs": [
